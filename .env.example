# 初次演示请显式使用 CONFIG_YAML_PATH=config/public_mock.yaml LLM_PROVIDER=mock。
# 仅设置 LLM_PROVIDER 无法覆盖所有 profile 路由；详见 README 与模型配置。
# 复制为 .env 后填入真实值。.env 已在 .gitignore 中,不会被提交。

# ===== Claude API =====
# Anthropic 控制台申请;P1 阶段所有写作/审稿/修订都走 Claude。
CLAUDE_API_KEY=

# ===== DashScope API(阿里云通义千问,v1.0.x post-wave5 H1 引入)=====
# 阿里云 DashScope 控制台 https://dashscope.console.aliyun.com/ 申请。
# WriterProfile.base_url 指向 dashscope endpoint
# (config.yaml 内 cloud_qwen_max_thinking / cloud_qwen_max_standard)时必填。
# 不命中这两个 profile 时不消耗 key,留空也不影响其他 provider 路径。
DASHSCOPE_API_KEY=
# POST-V8 单模型 qwen3.8-27b 还要求北京业务空间的非密钥 DNS label；
# 它只用于派生精确 workspace host，不是 API key，也不能填 trial/token-plan。
ALIBABA_MODEL_STUDIO_WORKSPACE_ID=

# ===== DeepSeek API(v1.1 wave 2 H2 引入)=====
# DeepSeek 控制台 https://platform.deepseek.com/ 申请。
# WriterProfile.base_url 指向 deepseek endpoint(https://api.deepseek.com)
# 时必填。同走 OpenAICompatibleClient 通配路径。
DEEPSEEK_API_KEY=

# ===== 腾讯 TokenHub API(POST-V8 单模型 hy3)=====
# 只会发送到精确官方 host https://tokenhub.tencentmaas.com；其它兼容 host
# 不得读取本字段。Provider-0 仓库默认 active=null，不会读取或使用该值。
TOKENHUB_API_KEY=

# ===== OpenAI 兼容 API 通配(v1.1 wave 2 H2 引入)=====
# 覆盖未单独列字段的 OpenAI 兼容 provider(典型:Moonshot / 智谱 GLM /
# OpenAI 官方 / 任何兼容服务)。WriterProfile.base_url 指向相应 endpoint 时,
# OpenAICompatibleClient 优先按规范 hostname authority 精确匹配各 provider 专字段
# (dashscope_api_key / deepseek_api_key / tokenhub_api_key 等),都未匹配时才用本字段。
OPENAI_COMPATIBLE_API_KEY=

# ===== 后端服务 =====
# 默认绑定 127.0.0.1(只允许本机访问)。需要别的机器访问才改 0.0.0.0,
# 但改 0.0.0.0 时必须同时把 API_AUTH_ENABLED 设为 true,否则启动会被拒绝。
API_HOST=127.0.0.1

# 默认 8000;如果本机 8000 被占用(比如别的服务在用),改成 8001/8888 等空闲端口即可。
API_PORT=8000

# 监听公网时必须开启鉴权,否则启动会被拒绝。本机自用保持 false 即可。
API_AUTH_ENABLED=false
# 鉴权开启时填一段足够长的随机字符串(比如 openssl rand -hex 32 生成)。
API_AUTH_TOKEN=

# ===== 数据 =====
# 所有工作区数据的根目录(每工作区一个子目录)。默认放仓库内 ./workspaces;
# 想换到外部硬盘可改成绝对路径,如 /Volumes/Data/novel-workspaces。
DATA_DIR=./workspaces

# ===== 日志 =====
# DEBUG / INFO / WARNING / ERROR。开发期想看详细日志改 DEBUG,日常用 INFO。
LOG_LEVEL=INFO

# ===== LLM provider =====
# 默认 mock(对齐 CLAUDE.md §维护人环境约束:维护人无 Claude API key,
# P1-P2 默认走 mock 不调真 API)。
#
# **v1.1 wave 2 起语义降级**(原"全局开关"→ 现"默认 provider 占位 + mock 路径
# 切换器"):Router 不再用本字段做 provider-mismatch fallback,改按 API key
# 可用性查询(详 src/core/routing/router.py)。真混跑 provider(本地 ollama
# memory_extractor + 云端 dashscope writer 同进程)在 config.yaml writer_profiles
# 内不同 profile 设不同 provider 即可,与本字段值无关。
#
# 仍需设置场景:① mock 路径开发 / 单测(本字段=mock 时 router 跳过所有 fallback)
# ② 启动 health check 默认 provider 可达性预检(读 config.yaml default profile,
# 本字段做后备兜底)。
LLM_PROVIDER=mock

# Mock verdict 控制(仅 LLM_PROVIDER=mock 时生效)。允许值 pass / revise / rewrite。
# 不设时默认 pass(章节一稿过审)。
LLM_MOCK_VERDICT=pass

# ===== 安全并行回退开关(post-v6 B) =====
# mini-plan Beat 对齐只在单卷内按最多 4 章组成严格波次；设 1 恢复逐章串行。
MINI_PLAN_BEAT_ALIGNMENT_MAX_CONCURRENCY=4
# ChapterCard 的 setting / must-vs-forbidden 两个只读 Judge；设 1 恢复串行。
CHAPTER_CARD_SEMANTIC_GATE_MAX_CONCURRENCY=2

# 章节级覆盖示例(同 workspace 内不同章节走不同路径):
# LLM_MOCK_VERDICT_CH_0001=revise   # ch-0001 单独跑 revise 路径
# LLM_MOCK_VERDICT_CH_0002=rewrite  # ch-0002 单独跑 rewrite 路径
# 命名规则:LLM_MOCK_VERDICT_ + chapter_id 大写 + 连字符替换为下划线

# ===== P3 引入,P1 不读取 =====
# QWEN_BASE_URL=http://localhost:11434/v1
